# ==============================================================================
# STYLE RADAR - VARIABLES DE ENTORNO LOCALES (.env)
# Arquitectura Hexagonal y Microservicios CADCHE
# ==============================================================================

# Puerto oficial CADche Stores Service
SERVER_PORT=8140

# Base de Datos PostgreSQL
POSTGRES_DB=styleradar_tiendas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Broker de Eventos RabbitMQ (Equipo Guatoque Jiraguas)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Azure Blob Storage (Azurite en local / Azure en cloud)
AZURE_STORAGE_BLOB_ENDPOINT=http://tiendas-blob:10000/devstoreaccount1

# Seguridad JWT: el MISMO secreto Base64 (>= 256 bits) que usa ms-auth en el ambiente.
# En qa/prod es obligatorio y no se aceptan los secretos de ejemplo de los repositorios.
JWT_SECRET_BASE64=REEMPLAZAR_POR_EL_SECRETO_BASE64_DE_MS_AUTH
# true solo en local o si el servicio esta restringido a la red del API Gateway (contrato B-0.3)
TRUST_GATEWAY_HEADERS=true
