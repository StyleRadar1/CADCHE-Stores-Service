# ==============================================================================
# STYLE RADAR - VARIABLES DE ENTORNO LOCALES (.env)
# Arquitectura Hexagonal y Microservicios CADCHE
# ==============================================================================

# Puerto oficial CADche Stores Service
SERVER_PORT=8140

# Base de Datos PostgreSQL
POSTGRES_DB=styleradar_tiendas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Broker de Eventos RabbitMQ (Equipo Guatoque Jiraguas)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Azure Blob Storage (Azurite en local / Azure en cloud)
AZURE_STORAGE_BLOB_ENDPOINT=http://tiendas-blob:10000/devstoreaccount1
