# ==============================================================================
# STYLERADAR · ms-tiendas · PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo a .env para ejecutar en local. Nunca suba un .env con credenciales reales.
# Los valores de QA y PROD se configuran como secretos de GitHub / App Settings de Azure.
# ==============================================================================

# Puerto y perfil de ejecucion (dev | docker | qa | prod)
SERVER_PORT=8140
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL 16 (ejecucion con ./mvnw en perfil dev)
DB_URL=jdbc:postgresql://localhost:5432/styleradar_tiendas
DB_USERNAME=postgres
DB_PASSWORD=postgres
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate

# PostgreSQL 16 (docker compose: crea la base y se la pasa a ms-tiendas como DB_NAME / DB_USER / DB_PASSWORD)
POSTGRES_DB=styleradar_tiendas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Broker de eventos RabbitMQ (styleradar.exchange)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Azure Blob Storage: fotos de la tienda, RUT y certificados.
# En el perfil docker se usa Azurite (tiendas-blob:10000) con su cadena de desarrollo por defecto.
# En QA/PROD es obligatoria la cadena de conexion de la cuenta de almacenamiento.
AZURE_STORAGE_CONNECTION_STRING=REEMPLAZAR_POR_LA_CADENA_DE_CONEXION_DE_AZURE_STORAGE
AZURE_STORAGE_CONTENEDORES_PUBLICOS=tiendas,documentos-almacenes,documentos-fundaciones

# Seguridad JWT: el MISMO secreto Base64 (>= 256 bits) que usa ms-auth en el ambiente.
# En qa/prod es obligatorio y no se aceptan los secretos de ejemplo de los repositorios.
JWT_SECRET_BASE64=REEMPLAZAR_POR_EL_SECRETO_BASE64_DE_MS_AUTH
# true solo en local o si el servicio esta restringido a la red del API Gateway (contrato B-0.3)
TRUST_GATEWAY_HEADERS=true

# Credencial Basic del servicio interno ms-segunda-vida-donaciones (/api/v1/internal/**).
# Sin contrasena las rutas internas responden 503.
DONACIONES_INTERNAL_USERNAME=ms-donaciones
DONACIONES_INTERNAL_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
# Credencial Basic de ms-auth (consulta interna del almacen de un administrador para el JWT)
AUTH_INTERNAL_USERNAME=ms-auth
AUTH_INTERNAL_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# URL que Swagger muestra como servidor (opcional)
SWAGGER_SERVER_URL=http://localhost:8140
